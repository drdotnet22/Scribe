# Copy this file to .env on the server (do not commit .env).

# ---- Sign-in (required) ----
# The address you open Scribe at. The sign-in callback is APP_URL/auth/callback.
APP_URL=https://scribe.local:5877
# Your OpenID Connect provider. For Pocket ID this is its address, e.g. https://id.example.com
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=paste-the-client-id
OIDC_CLIENT_SECRET=paste-the-client-secret
# The one account allowed to use Scribe: its email, username, or subject id at the provider.
AUTH_ALLOWED_USER=you@example.com
# Optional: how many days you stay signed in (renewed as you use it). Default 30.
# SESSION_DAYS=30

# ---- Joplin notes sync (optional) ----
# Remove these lines if you do not use Joplin.
COMPOSE_PROFILES=joplin
JOPLIN_URL=http://joplin:41186

# Your self-hosted Joplin Server and the account you sign in with in Joplin.
JOPLIN_SERVER_URL=http://YOUR-SERVER:22300
JOPLIN_USERNAME=you@example.com
JOPLIN_PASSWORD=your-joplin-password
