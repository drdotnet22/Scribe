# Copy this file to .env on the server (do not commit .env) to turn on the Joplin notes sync.
COMPOSE_PROFILES=joplin
JOPLIN_URL=http://joplin:41186

# Your self-hosted Joplin Server and the account you sign in with in Joplin.
JOPLIN_SERVER_URL=http://YOUR-SERVER:22300
JOPLIN_USERNAME=you@example.com
JOPLIN_PASSWORD=your-joplin-password
