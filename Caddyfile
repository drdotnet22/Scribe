# HTTPS for Scribe on your own network. Caddy makes a certificate from its own
# certificate authority ("tls internal"); install caddy-data/.../root.crt on each computer once.

scribe.local {
	tls internal
	encode zstd gzip
	reverse_proxy app:3000
}

# Plain http: hand out the root certificate, send everything else to https.
http://scribe.local {
	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		file_server
	}
	handle {
		redir https://scribe.local{uri} permanent
	}
}
