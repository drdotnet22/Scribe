# HTTPS for Scribe on your own network, on port 5877. Caddy makes a certificate from its own
# certificate authority ("tls internal"); install root.crt on each computer once (see the README).
{
	auto_https disable_redirects
}

scribe.local:5877 {
	tls internal
	encode zstd gzip

	# The public root certificate, to install on your computers.
	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
